{
  "name": "garage-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "node scripts/dev.cjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:migrate": "ts-node src/database/migrate.ts",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:e2e": "npm run build && node --test test/*.e2e.cjs",
    "admin:promote": "ts-node src/database/promote-admin.ts",
    "maintenance": "ts-node src/database/maintenance.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "helmet": "^8.0.0",
    "nodemailer": "^10.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "multer": "^2.3.0"
  }
}
