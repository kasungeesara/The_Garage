NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=garagedb
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-password
SESSION_DAYS=7
# SMTP is required in production. Configure a test inbox locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=AutoPart Hub <noreply@example.com>
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VIEW_HASH_SECRET=
# Set only behind the documented reverse proxy, which replaces forwarded headers.
TRUST_PROXY=
# Managed PostgreSQL TLS. A PEM CA is optional; never disable verification.
DB_SSL=false
DB_SSL_CA=
